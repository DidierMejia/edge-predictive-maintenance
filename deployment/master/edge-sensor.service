[Unit]
Description=Receptor USB de sensores Edge (ESP32)
After=multi-user.target

[Service]
Type=simple
User=didier
WorkingDirectory=/home/didier/edge_predictive_maintenance
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/didier/edge_predictive_maintenance/.venv/bin/python /home/didier/edge_predictive_maintenance/sensors/serial_reader.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
